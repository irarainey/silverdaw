{
  "name": "silverdaw",
  "version": "1.10.0",
  "description": "A remix-first DAW",
  "author": {
    "name": "Ira Rainey"
  },
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json --composite false && tsc --noEmit -p tsconfig.node.json --composite false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "test:e2e:only": "playwright test",
    "test:e2e:report": "playwright show-report",
    "dist": "electron-vite build && electron-builder --win --x64 --config electron-builder.yml",
    "dist:store": "electron-vite build && electron-builder --win --x64 --config electron-builder.store.cjs",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir --config electron-builder.yml"
  },
  "dependencies": {
    "@vue/devtools-api": "^8.2.1",
    "music-metadata": "^11.16.1",
    "pinia": "^4.1.0",
    "pixi.js": "^8.22.0",
    "vue": "^3.5.44",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.12"
  }
}
